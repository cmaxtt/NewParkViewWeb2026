# Copy these values into the machine/user environment used by the scheduled task.
# Generate a hash with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('replace-me'))"
PARKVIEW_SECRET_KEY=replace-with-a-long-random-value
PARKVIEW_PORT=5050
PARKVIEW_ADMIN_USERNAME=Admin
PARKVIEW_ADMIN_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
# Set to true only when the site is served through HTTPS.
PARKVIEW_COOKIE_SECURE=false
